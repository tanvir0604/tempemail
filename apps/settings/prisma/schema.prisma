// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TempEmail {
  id            String         @id @default(uuid())
  emailId       String
  email         String         @unique
  expiredAt     DateTime
  userId        String?
  status        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  emailContents EmailContent[]
}

model EmailContent {
  id          String   @id @default(uuid())
  content     Json
  fromName    String?
  from        String?
  to          String?
  subject     String?
  text        String?
  html        String?  @db.Text
  attachments Json?
  messageId   String   @unique
  references  String?
  uid         Int
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updateAt    DateTime @updatedAt

  tempEmail    TempEmail @relation(fields: [tempEmailRef], references: [email], onDelete: Cascade)
  tempEmailRef String
}

model Domain {
  id     String @id @default(uuid())
  domain String @unique
  apiUrl String
  apiKey String

  imapHost String
  imapPort String

  status      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updateAt    DateTime     @updatedAt
  domainUsers DomainUser[]
}

model DomainUser {
  id           String   @id @default(uuid())
  apiUserName  String
  apiPassword  String
  imapUserName String
  imapPassword String
  status       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updateAt     DateTime @updatedAt

  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId String
}
